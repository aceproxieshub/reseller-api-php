{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": [
            "src"
        ]
    },
    "logs": {
        "text": "build/infection.log"
    },
    "minMsi": 100,
    "minCoveredMsi": 100,
    "mutators": {
        "@default": true,
        // Native sleeping is covered through the injected deterministic sleeper;
        // asserting elapsed wall-clock time here would make the suite slow and flaky.
        "FunctionCallRemoval": {
            "ignoreSourceCodeByRegex": [
                "usleep\\(\\$microseconds\\);"
            ]
        },
        // The retry policy tests inject deterministic jitter. Statistical assertions
        // against random_int() would be nondeterministic and would not verify behavior.
        "DecrementInteger": {
            "ignoreSourceCodeByRegex": [
                ".*random_int\\(\\(int\\) \\(\\$delay / 2\\), \\$delay\\);"
            ]
        },
        "IncrementInteger": {
            "ignoreSourceCodeByRegex": [
                ".*random_int\\(\\(int\\) \\(\\$delay / 2\\), \\$delay\\);"
            ]
        },
        // Multiplying a digit-only numeric string already produces the same integer;
        // removing this explicit cast is behaviorally equivalent in PHP.
        "CastInt": {
            "ignoreSourceCodeByRegex": [
                "return \\(int\\) \\$retryAfter \\* 1_000_000;"
            ]
        }
    }
}
