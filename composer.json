{
    "name": "aceproxieshub/reseller-api-php",
    "type": "library",
    "autoload": {
        "psr-4": {
            "Aceproxies\\ResellerApi\\": "src/"
        }
    },
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^4.0",
        "slevomat/coding-standard": "^8.31",
        "phpstan/phpstan": "^2.2",
        "rector/rector": "^2.6"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
