{
    "name": "aceproxieshub/reseller-api-php",
    "description": "PHP API library for the Aceproxies reseller API",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Aceproxies\\ResellerApi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Aceproxies\\ResellerApi\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.3",
        "symfony/http-client": "^7.0"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^4.0",
        "slevomat/coding-standard": "^8.31",
        "phpstan/phpstan": "^2.2",
        "rector/rector": "^2.6",
        "phpunit/phpunit": "^13.2",
        "infection/infection": "^0.34.1"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "infection/extension-installer": true
        }
    }
}
